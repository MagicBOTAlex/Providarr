{
  "server": {
    "host": "0.0.0.0",
    "port": 4155,
    "request_timeout": "30s"
  },
  "database": {
    "url": "postgres://providarr:providarr@127.0.0.1:5432/providarr",
    "max_connections": 10,
    "min_connections": 1,
    "acquire_timeout": "10s"
  },
  "cache": {
    "enabled": true,
    "default_ttl": "90d",
    "max_ttl": "180d",
    "min_ttl": "1h",
    "negative_ttl": "5m",
    "not_found_ttl": "1h",
    "stale_if_error": "30d",
    "honor_cache_control": false,
    "request_coalescing": true,
    "stale_while_revalidate": true,
    "max_body_bytes": 10485760
  },
  "search": {
    "hydrate_limit": 5
  },
  "backoff": {
    "base_delay": "500ms",
    "factor": 2.0,
    "max_delay": "60s",
    "jitter": 0.2,
    "max_consecutive_failures": 8,
    "drop_after_wait": "10s",
    "max_retries": 3
  },
  "replay": {
    "enabled": false,
    "dir": "fixtures",
    "fallback_to_upstream": false,
    "record": false
  },
  "inbound": {
    "enabled": true,
    "requests_per_second": 2.0,
    "burst": 5,
    "global_requests_per_second": 100.0,
    "global_burst": 200,
    "max_concurrent": 128,
    "trust_forwarded_for": false,
    "bypass": ["127.0.0.1", "::1"]
  },
  "api_auth": {
    "enabled": false,
    "api_key": "",
    "header": "x-api-key"
  },
  "logging": {
    "enabled": true,
    "dir": "logs",
    "filename_prefix": "providarr",
    "rotation": "daily",
    "max_files": 7,
    "stdout": true
  },
  "providers": {
    "tmdb": {
      "base_url": "https://api.themoviedb.org/3",
      "requests_per_second": 40.0,
      "burst": 40,
      "max_concurrency": 8,
      "request_timeout": "15s",
      "connect_timeout": "5s",
      "documented_rate_limit": "~50 requests/second per API key (documented; not probed)",
      "auth": { "style": "bearer", "env_var": "TMDB_API_TOKEN" }
    },
    "tvdb": {
      "base_url": "https://api4.thetvdb.com/v4",
      "requests_per_second": 1.0,
      "burst": 5,
      "max_concurrency": 2,
      "request_timeout": "15s",
      "connect_timeout": "5s",
      "documented_rate_limit": "conservative default pending review of TVDB terms (not probed)",
      "auth": { "style": "tvdb_login", "env_var": "TVDB_API_KEY" }
    }
  }
}
