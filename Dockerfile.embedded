# syntax=docker/dockerfile:1
# All-in-one image: Providarr + an embedded Postgres 16 in the same container.

# ---- build stage -----------------------------------------------------------
FROM rust:1.99-bookworm@sha256:59037199c44290f2befcdd58dcc540164763fc296950255aaefeef096a1866b0 AS builder
WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config cmake clang libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN cargo build --release --locked

# ---- runtime stage (Postgres base already ships postgres + gosu) ------------
FROM postgres:18-bookworm@sha256:3725f4e2499eef5134592b3b4ab79a543ed7f8e533b05b5b637af926630f6650 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --uid 1000 --home-dir /app --create-home --shell /usr/sbin/nologin providarr

WORKDIR /app
COPY --from=builder /build/target/release/providarr /usr/local/bin/providarr
COPY config ./config
COPY LICENSE ./LICENSE
COPY docker/entrypoint-embedded.sh /usr/local/bin/entrypoint-embedded.sh
RUN chmod +x /usr/local/bin/entrypoint-embedded.sh

RUN mkdir -p /app/logs && chown -R providarr:providarr /app/logs /app/config

ENV PROVIDARR_CONFIG=/app/config/config.json \
    PGDATA=/var/lib/postgresql/data \
    POSTGRES_USER=providarr \
    POSTGRES_DB=providarr

EXPOSE 4155
VOLUME ["/var/lib/postgresql/data", "/app/logs"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
    CMD curl -fsS http://127.0.0.1:4155/health || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint-embedded.sh"]
